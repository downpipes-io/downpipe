#!/bin/sh
# Repo-tracked hook, wired up via `make hooks` (sets core.hooksPath to this
# directory). Block staged content carrying automated-tool attribution: a co-authorship
# trailer, a "generated with/by" note, a sign-off trailer that names a bot rather than a
# person, or a line describing the change as the output of a code assistant.
#
# hooks/ itself is excluded from the scan: this file and hooks/commit-msg carry the
# marker patterns as literal regex text, which is not a marker being laundered into
# the repository. A real marker in the commit message is still caught by
# hooks/commit-msg, and a real marker anywhere else in the tree is still caught here.
if git diff --cached -U0 -- . ':(exclude)hooks/*' | grep -E '^\+' | grep -iEq 'co-authored-by:|generated (with|by)\b|signed-off-by:.*(\[bot\]|\bbot\b|\bassistant\b|\bai\b)|\b(ai|code|language[- ]model)[- ]assistant\b|\bwritten by (an? )?(ai|bot|assistant)\b|🤖' ; then
  echo "pre-commit hook: automated-tool attribution in staged content; remove it" >&2
  exit 1
fi
